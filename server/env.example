# 服务器配置
PORT=5000
NODE_ENV=development

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/nas

# 显示用户信息开关 (true/false)
SHOW_USER_INFO=false

# 文件上传配置
UPLOAD_PATH=./storage/uploads
MAX_FILE_SIZE=21474836480

# JWT配置
JWT_SECRET=nas_secret_key
JWT_EXPIRES_IN=2h

# 存储配额配置 (500GB)
DEFAULT_STORAGE_QUOTA=536870912000

# 允许的文件类型 (用逗号分隔，*表示所有类型)
ALLOWED_FILE_TYPES=* 